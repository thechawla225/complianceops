// -----------------------------------------------------Dev Postgres credentials in Secrets Manager (ADR 0015)-----------------------------------------------------
// The password is generated by Secrets Manager and written with a write-only attribute, so it is never stored in
// Terraform state or plan files. External Secrets Operator copies it into the cluster (non-persistent/external-secrets.tf).
// Persistent, not non-persistent: the secret outlives cluster rebuilds, and a deleted secret's name stays reserved for
// its 7-30 day recovery window, which would break the next apply.
// Rotate: bump postgres_password_version, apply, then restart postgres and transaction (the dev data is an emptyDir).

locals {
  postgres_password_version = 1
}

ephemeral "aws_secretsmanager_random_password" "postgres" {
  password_length     = 32
  exclude_punctuation = true // embedded in DATABASE_URL, so no URL-special characters
}

resource "aws_secretsmanager_secret" "postgres" {
  #checkov:skip=CKV_AWS_149:AWS-managed aws/secretsmanager key is enough for a dev password and costs nothing; a customer-managed key adds ~$1/month for no dev benefit (ADR 0015)
  #checkov:skip=CKV2_AWS_57:rotated by hand (bump postgres_password_version); automatic rotation needs a Lambda, not worth it for dev (ADR 0015)
  name        = "complianceops/dev/postgres"
  description = "Dev Postgres password for complianceops (synced into the cluster by External Secrets Operator)"
}

resource "aws_secretsmanager_secret_version" "postgres" {
  secret_id                = aws_secretsmanager_secret.postgres.id
  secret_string_wo         = jsonencode({ password = ephemeral.aws_secretsmanager_random_password.postgres.random_password })
  secret_string_wo_version = local.postgres_password_version
}

output "postgres_secret_arn" {
  value = aws_secretsmanager_secret.postgres.arn
}
